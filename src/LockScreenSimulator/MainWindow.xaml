<Window x:Class="LockScreenSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forensic Lab Simulation" WindowState="Maximized" WindowStyle="None"
        ResizeMode="CanResize" Topmost="False" Background="#101114" Foreground="#F4F4F5">
    <Grid Margin="48">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#7F1D1D" Padding="12" CornerRadius="6">
            <TextBlock Text="LABORATORY SIMULATION — NOT A SYSTEM LOCK" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" />
        </Border>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="900">
            <TextBlock Text="Forensic incident simulation" FontSize="46" FontWeight="SemiBold" Margin="0,0,0,28"/>
            <TextBlock Text="{Binding Message}" FontSize="22" TextWrapping="Wrap" Margin="0,0,0,30"/>
            <TextBlock Text="Display-only countdown" Foreground="#A1A1AA" FontSize="15"/>
            <TextBlock Text="{Binding RemainingText}" FontFamily="Consolas" FontSize="62"/>
            <TextBlock Text="{Binding ScenarioId}" FontFamily="Consolas" Foreground="#A1A1AA" Margin="0,20,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="Alt+F4 remains enabled." VerticalAlignment="Center" Margin="0,0,20,0" Foreground="#A1A1AA"/>
            <Button Content="Exit laboratory view" Padding="18,10" Click="Exit_Click"/>
        </StackPanel>
    </Grid>
</Window>
